# Код доступа на экране входа (встраивается при сборке)
VITE_CLASS_CODE=

# Gemini API — встраивается в сайт при npm run build (см. README про referrers)
VITE_GEMINI_API_KEY=

# Опционально: URL Cloudflare Worker-прокси (ключ хранится только на worker)
# VITE_GEMINI_PROXY_URL=https://your-worker.workers.dev
